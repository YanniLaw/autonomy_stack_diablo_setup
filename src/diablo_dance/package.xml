<?xml version="1.0"?>
<package format="3">
  <name>diablo_dance</name>
  <version>0.1.0</version>
  <description>Choreography + record/replay tools for DIABLO via /diablo/MotionCmd (motion_msgs/MotionCtrl).</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Provided by DDTRobot/diablo_ros2 (diablo_interfaces) -->
  <exec_depend>motion_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
